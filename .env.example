# Postiz secrets for docker-compose.prod.full.yaml.
#   cp .env.example .env && chmod 600 .env
# Compose reads this file for ${...} substitution and passes it to the postiz container
# (env_file). After an edit, apply it with:
#   docker compose -f docker-compose.prod.full.yaml up -d postiz
# Wrap a value in single quotes if it contains $, # or spaces.
# A provider with an empty ID/secret stays unavailable in Postiz; fill it in when ready.

# ── Compose ─────────────────────────────────────────────────────────────────
# Lets plain `docker compose ...` use the production file without -f.
COMPOSE_FILE=docker-compose.prod.full.yaml
# Pin a build (sha-<7 chars>). The CI deploy overrides this with the build it just made.
# PHANTOM_POSTIZ_TAG=

# ── Required ────────────────────────────────────────────────────────────────
# Changing JWT_SECRET logs every Postiz user out. Generate with: openssl rand -hex 32
JWT_SECRET=
DATABASE_URL='postgresql://postiz:CHANGE_ME@phantompulse-postgres:5432/postiz-db'

# ── Meta: Facebook + Instagram (business, via Facebook login) ──────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram standalone (Instagram login, no Facebook page)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── LinkedIn (profiles and pages) ───────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── X (Twitter) ─────────────────────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=

# ── Google: YouTube and Google Business Profile ─────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Leave empty to reuse the YouTube client above.
GOOGLE_GMB_CLIENT_ID=
GOOGLE_GMB_CLIENT_SECRET=

# ── TikTok ──────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# TikTok Business (separate app)
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=

# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather; the bot name is the username without the @.
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=

# ── Other providers — fill only the ones you enable ────────────────────────
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_SECRET=
VK_ID=
WHOP_CLIENT_ID=
MEWE_HOST=
MEWE_APP_ID=
MEWE_API_KEY=
NEYNAR_CLIENT_ID=
NEYNAR_SECRET_KEY=
